#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/layout_shift.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>
#include <layout_shift.dtsi>

&kscan {
    events = <
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(0,0,10)
        ZMK_MOCK_RELEASE(0,0,10)
    >;
};

/ {
    test_map: test_map {
        compatible = "zmk,layout-shift-map";
        mappings = <
            A B LAYOUT_SHIFT_OPTIONAL_ALL
            C D LAYOUT_SHIFT_OPTIONAL_ALL
        >;
    };

    macros {
        macro_test: macro_test {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &macro_press
                &macro_param_1to1 &kpls MACRO_PLACEHOLDER
                &macro_param_2to1 &kpls MACRO_PLACEHOLDER
                &macro_pause_for_release
                &macro_release
                &macro_param_2to1 &kpls MACRO_PLACEHOLDER
                &macro_param_1to1 &kpls MACRO_PLACEHOLDER
            >;
        };
    };

    behaviors {
        test_toggle: test_toggle {
            compatible = "zmk,behavior-layout-shift-toggle";
            #binding-cells = <0>;
            toggle-mode = "on";
            layout-maps = <&test_map>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &macro_test A C &test_toggle
                &none &none
            >;
        };
    };
};
